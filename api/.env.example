
 Server
PORT=3001
NODE_ENV=development
NOTIFICATIONS_ENABLED=true

# App
APP_URL=http://localhost:3000

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=my_daily_page
POSTGRES_PORT=5434
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_daily_page?schema=public"

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# WhatsApp provider: twilio (default) or ultramsg
WHATSAPP_PROVIDER=twilio
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# Twilio (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=

# MinIO (images de tâches)
STORAGE_DRIVER=s3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=mydailypage
MINIO_SECRET_KEY=mydailypage-minio
MINIO_BUCKET=my-daily-page
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_CONSOLE_PORT=9001

# P3 — réception SMS/WhatsApp (URL publique HTTPS exacte configurée chez Twilio)
TWILIO_INBOUND_URL=

# Template quick-reply approuvé : body {{1}}, bouton « J’ai fait » payload {{2}}
TWILIO_WHATSAPP_QUICK_REPLY_SID=

# Secret dédié aléatoire >=32 caractères, différent du token API UltraMsg
ULTRAMSG_WEBHOOK_SECRET=

# P3 — Web Push (générer via : npx web-push generate-vapid-keys --json)
VAPID_PUBLIC_KEY=BCeWlHcMobreVYYZMHMaV7l9LOBWrVg85FqPuiA2avlH_UY3QkuEkHkC7syy1D4pcLQVM9vHHQUUZQxsd1Qy2lY
VAPID_PRIVATE_KEY=99pplDU1ygeZquBxxwZecYJz73Jb5-HqQQZBAShhKJI
VAPID_SUBJECT=mailto:admin@example.com

# Optional AI suggestions for personal task templates (both required; restart API).
TEMPLATE_AI_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TEMPLATE_AI_MODEL=gpt-6-luna

# P2 — Suivi des livraisons (URLs HTTPS publiques à configurer en production)
# Twilio : URL exacte utilisée comme statusCallback pour les SMS et WhatsApp
TWILIO_STATUS_CALLBACK_URL=
# Resend : secret whsec_... du webhook /notification-webhooks/resend
RESEND_WEBHOOK_SECRET=
