
 Server
PORT=3001
NODE_ENV=development

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=my_daily_page
POSTGRES_PORT=5434
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_daily_page?schema=public"

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Twilio (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
